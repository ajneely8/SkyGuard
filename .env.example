# Copy to .env to send real verification emails.
# Without RESEND_API_KEY the mail server still issues codes, but prints them to
# its own terminal instead of emailing them. The browser never receives the code
# either way.

# https://resend.com — create an API key, then verify a sending domain.
RESEND_API_KEY=

# Must be an address on a domain you have verified with Resend.
# Resend's shared sandbox sender only delivers to your own account address.
MAIL_FROM=Skyguard <onboarding@resend.dev>

# Port the mail server listens on (Vite proxies /api here).
VERIFY_PORT=8787

# Fixed code that passes verification while RESEND_API_KEY is empty, so sign-up
# is not blocked before email is wired up. It is accepted ONLY when there is no
# mail key — setting RESEND_API_KEY disables it automatically.
DEV_CODE=123456
