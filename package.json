{
  "name": "skyguard-weather",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Skyguard — precise-location weather, live radar, lightning and WBGT heat safety for school athletics",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:mail": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev:all": "concurrently -n web,mail -c cyan,magenta \"npm:dev:web\" \"npm:dev:mail\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
